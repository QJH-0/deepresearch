DASHSCOPE_API_KEY=
MODEL=qwen-plus
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant
MAX_ITERATIONS=3
ENABLE_MEMORY=true
# ── 对话摘要压缩 ──
SUMMARY_THRESHOLD=20
SUMMARY_KEEP_RECENT=6
SUMMARY_MODEL=qwen-turbo
SAVE_CONVERSATION_TASK=false
CHECKPOINTER_BACKEND=auto
ENABLE_MILVUS=true
MEMORY_TOP_K=6
REDIS_URL=
POSTGRES_DSN=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory
NO_COLOR=
WORKSPACE_DIR=/workspace
TAVILY_API_KEY=

# ── JWT 认证（必需）──
# 为空时认证接口 fail-closed：拒绝签发与校验令牌（503），不会放行
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# 用户表：user:pass[:role],user2:pass2；role=admin 可访问管理端点
AUTH_USERS=

# ── RabbitMQ（为空时降级为同步向量化）──
RABBITMQ_URL=
