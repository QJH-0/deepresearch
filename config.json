{
  "model": "qwen-plus",
  "tenant_id": "default_tenant",
  "user_id": "default_user",
  "thread_id": "default",
  "max_iterations": 3,
  "enable_memory": true,
  "memory_embedding_model": "text-embedding-v3",
  "memory_hot_path_top_k": 5,
  "memory_background_enabled": true,
  "memory_extract_model": "qwen-turbo",
  "save_conversation_task": false,
  "checkpointer_backend": "postgres",
  "enable_milvus": true,
  "milvus_collection": "mult_agent_memory",
  "minio_bucket": "deep-research-docs",
  "minio_secure": false,
  "rabbitmq_chunk_sync_exchange": "chunk-sync",
  "hitl_enabled": true,
  "hitl_config": {
    "plan_review": true,
    "analyze_clarify": true,
    "write_review": false,
    "clarify_max_rounds": 2
  },
  "search_providers": ["ddgs", "tavily", "searxng"],
  "rerank_model_name": "gte-rerank-v2",
  "enable_rerank_model": true,
  "evidence_llm_fusion": true,
  "evidence_prior_weight": 0.4,
  "sse_heartbeat_seconds": 15,
  "thinking_nodes": ["write", "deep_dive", "analyze"],
  "chunk_retry_limit": 3
}
