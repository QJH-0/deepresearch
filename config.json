{
  "model": "qwen3.8-max",
  "node_models": {
    "write": { "model": "qwen3.7-plus" },
    "deep_dive": { "model": "qwen3.8-max" },
    "analyze": { "model": "qwen3.8-max" },
    "plan": { "model": "qwen3.8-max" },
    "retrieve_grader": { "model": "qwen3.7-plus" },
    "web_search": { "model": "qwen3.7-flash" },
    "local_rag": { "model": "qwen3.7-flash" },
    "intent_router": { "model": "qwen3.7-flash" },
    "direct_answer": { "model": "qwen3.8-flash" },
    "clarify": { "model": "qwen3.7-flash" }
  },
  "tenant_id": "default_tenant",
  "user_id": "default_user",
  "thread_id": "default",
  "max_iterations": 3,
  "max_retrieval_rounds": 2,
  "enable_memory": true,
  "memory_embedding_model": "text-embedding-v3",
  "memory_hot_path_top_k": 5,
  "memory_background_enabled": true,
  "memory_extract_model": "qwen3.7-flash",
  "summary_model": "qwen3.7-flash",
  "title_model": "qwen3.7-flash",
  "scorer_model": "qwen3.7-flash",
  "save_conversation_task": false,
  "checkpointer_backend": "postgres",
  "enable_milvus": true,
  "milvus_collection": "mult_agent_memory",
  "minio_bucket": "deep-research-docs",
  "minio_secure": false,
  "rabbitmq_chunk_sync_exchange": "chunk-sync",
  "hitl_enabled": true,
  "hitl_config": {
    "plan_review": true,
    "analyze_clarify": true,
    "write_review": false,
    "clarify_max_rounds": 2
  },
  "search_providers": ["ddgs", "tavily", "searxng"],
  "rerank_model_name": "gte-rerank-v2",
  "enable_rerank_model": true,
  "evidence_llm_fusion": true,
  "evidence_prior_weight": 0.4,
  "context_evidence_limit": 40,
  "context_evidence_budget_chars": 60000,
  "sse_heartbeat_seconds": 15,
  "thinking_nodes": [],
  "llm_timeout_seconds": 60,
  "llm_max_retries": 2,
  "run_timeout_seconds": 900,
  "search_timeout_seconds": 15,
  "chunk_retry_limit": 3
}
